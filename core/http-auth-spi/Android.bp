java_library_host {
    name: "awssdk-http-auth-spi",
    srcs: ["src/main/**/*.java"],
    libs: ["awssdk-annotations"],
    static_libs: [
        "awssdk-http-client-spi",
        "awssdk-identity-spi",
        "awssdk-utils",
    ],
    target: {
        windows: {
            enabled: true,
        },
    },
}
