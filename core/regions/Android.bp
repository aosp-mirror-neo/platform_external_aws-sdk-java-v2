java_library_host {
    name: "awssdk-regions",
    srcs: [
        "src/main/**/*.java",
        // These files were generated locally with maven: `mvn generate-sources`,
        // and then checked in with `git add -f`, so that soong can build this
        // target from source.
        "target/generated-sources/**/*.java",
    ],
    libs: [
        "slf4j-api",
        "awssdk-annotations",
    ],
    static_libs: [
        "awssdk-sdk-core",
        "awssdk-profiles",
        "awssdk-json-utils",
    ],
    target: {
        windows: {
            enabled: true,
        },
    },
}
