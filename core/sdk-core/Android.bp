java_library_host {
    name: "awssdk-sdk-core",
    srcs: [
        "src/main/**/*.java",
        // These files were generated locally with maven: `mvn generate-sources`,
        // and then checked in with `git add -f`, so that soong can build this
        // target from source.
        "target/generated-sources/**/*.java",
    ],
    libs: [
        "slf4j-api",
        "awssdk-annotations",
    ],
    static_libs: [
        "awssdk-http-client-spi",
        "awssdk-metrics-spi",
        "awssdk-endpoints-spi",
        "awssdk-http-auth-spi",
        "awssdk-http-auth-aws",
        "awssdk-checksums-spi",
        "awssdk-checksums",
        "awssdk-identity-spi",
        "awssdk-utils",
        "awssdk-profiles",
    ],
    errorprone: {
        javacflags: [
            "-Xep:DoubleBraceInitialization:WARN",
        ],
    },
    target: {
        windows: {
            enabled: true,
        },
    },
}
