java_library_host {
    name: "awssdk-aws-json-protocol",
    srcs: ["src/main/**/*.java"],
    libs: [
        "slf4j-api",
        "awssdk-annotations",
    ],
    static_libs: [
        "awssdk-aws-core",
        "awssdk-protocol-core",
        "awssdk-sdk-core",
        "awssdk-json-utils",
    ],
    // TODO(b/328041351)
    // target: {
    //     windows: {
    //         enabled: true,
    //     },
    // },
}
